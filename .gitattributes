# Keep content-addressed robot sources, recordings and verification inputs exact.
/assets/unitree_h2_v1/** -text
/simulation/humanoid_v1/** -text
/assets/cooling_lab_v1/** -text
/viewer/lab_review_v1/** -text
/assets/g1_sensor_rig_v1/** -text
# Preserve vendor whitespace and legacy-encoded CAD headers as source evidence.
/assets/g1_sensor_rig_v1/vendor/** -whitespace
/assets/g1_sensor_rig_v1/vendor/**/*.STEP -diff
/assets/g1_sensor_rig_v1/geometry/*.step -diff -whitespace
# Generated trajectories and frozen evidence stay byte-exact across checkouts.

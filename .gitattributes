/viewer/cooling_concept_v2/audits/** -text linguist-generated=true
/viewer/cooling_concept_v2/single_measurement_episode.json -text linguist-generated=true
# Preserve upstream locomotion source snapshots, including vendor whitespace.
/simulation/g1_cooling_demo/runs/*/locomotion_policy_source/reference/** -text -whitespace
/simulation/g1_cooling_demo/locomotion_policy/reference/action_manager.h -text -whitespace

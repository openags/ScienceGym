  "semantics": "Static edges relate reusable operation templates. Execution must instantiate scope keys; membership order is not a universal runtime route. No backward dependency is satisfied by a future or different-branch receipt.",
  "conditional_gates": [
    {
      "operation": "SWEEP_CONFIG",
      "requirement": "NO_OBJECT requires current CLEAR_APERTURE; HALF_APERTURE requires current ALIGN showing half blockage"
    },
    {
      "operation": "ENABLE",
      "requirement": "Exactly one current SWEEP_CONFIG or SCAN_CONFIG; frequency reference and safe-exposure card match that mode"
    },
    {
      "operation": "CALIBRATE",
      "requirement": "Installation changes invalidate calibration if the qualification card requires it; return wiring must match channel map"
    },
    {
      "operation": "RIG_CHECK",
      "requirement": "All four distinct MIC_INSTALL occurrences required; one template occurrence cannot cover all ports"
    },
    {
      "operation": "RUN_REVIEW",
      "requirement": "STOP must follow the corresponding final/aborted point; start/readback alone cannot imply raw coverage"
    },
    {
      "operation": "CONTROL_COMPARE",
      "requirement": "Both control datasets have matching approved frequency schedules, shared condition fields and declared permissible differences"
    },
    {
      "operation": "TRANSFER",
      "requirement": "Instantiate before each interstation change; require actual origin, destination, power-safe detachment, retained carrier, destination identity and dock receipt"
    },
    {
      "operation": "TARGET_LOAD",
      "requirement": "Same target version has QC, transfer and holder receipt; after damage/repair prior QC is stale"
    },
    {
      "operation": "ARCHIVE",
      "requirement": "Can archive partial/failed work; archive receipt alone never marks an incomplete branch complete"
    },
    {
      "operation": "TARGET_QC",
      "requirement": "Manufactured target requires TARGET_RELEASE then TRANSFER from WS_PREP; supplied part requires TARGET_RECEIVE then TRANSFER from WS_STOCK. Exactly one preparation route per target."
    },
    {
      "operation": "REPORT",
      "requirement": "Normal full closure requires CLEANUP; blocked or interrupted closure requires ABORT_CLOSE. In neither case may missing branches be called complete."
    },
    {
      "operation": "CALIBRATE",
      "requirement": "In-situ at WS_RIG only, with transported standard; sensor removal is not implemented unless an independently qualified removal/reseat route is supplied."
    },
    {
      "operation": "STOCK",
      "requirement": "Only gates for the selected stock item apply; print/target settings do not block unrelated foam or sensor retrieval."
    }
  ],
  "occurrence_key": [
    "episode_id",
    "branch_id",
    "run_id",
    "attempt_id",
    "operation_id",
    "iteration_key"
  ],
  "allowed_equivalent_routes": "Any route satisfying dependencies, state transitions and data integrity can be accepted; not restricted to the illustrative order",
  "transfer_obligations": "F_GUIDE enumerates four guide/material station transfers. F_TARGET route variants include preparation-to-inspection and inspection-to-rig transfer; F_RIG enumerates transported resources including calibration standard. Branch target unloading requires rig-to-archive transfer; teardown records transfer of disconnected components to their identified stores. Each is a distinct TRANSFER occurrence, not a teleport or one global receipt."

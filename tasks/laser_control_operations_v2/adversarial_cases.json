{
  "schema_version": "laser_control_task.v1",
  "required_rejections": [
    "unknown/malformed fixture ID",
    "cross-DFB/preparation/variant replay",
    "extra or missing actor fields",
    "actor-supplied outcomes",
    "duplicate event or evidence IDs",
    "missing/reordered safety observation",
    "request treated as proof of lock or safe off",
    "wrong or changed package/design/mount/calibration/reference/control lineage",
    "free/locked bias-noise mismatch",
    "in-loop substituted for independent heterodyne",
    "nonfinite, boolean, negative or malformed PSD values",
    "insufficient/unsorted frequency support",
    "PSD/ASD or Hz/rad mismatch",
    "zero or invalid discriminator gain",
    "changed raw hash or fixture content",
    "damage reused without qualification",
    "full preparation falsely credited to prepared intake",
    "export extra files, traversal, duplicate members, symlinks or changed bytes"
  ]
}

  "semantics": "Dependencies express receipts, not required immediate adjacency. Preparation receipts may originate from an explicit scoped handoff. Repeated operations get new instance IDs.",
  "conditional_gates": [
    {
      "operation": "OPT_SUMMARY",
      "requires_one_complete_family": [
        "OPT_SCAN",
        "ANGLE_SCAN"
      ]
    },
    {
      "operation": "PID_STEP",
      "requires": "POWER_BASELINE for first step; prior STEP_SUMMARY plus stable state for later steps"
    },
    {
      "operation": "STAG_LOG",
      "requires": "TRACK_ADJUST coverage for disk route OR BAND_CHECK coverage for fixed route"
    },
    {
      "operation": "SITE_SETUP",
      "requires": "Current assembly revision after HEATER_ATTACH, FIXED_SWAP or MAP_ATTACH as applicable"
    },
    {
      "operation": "MAP_LOG",
      "requires": "site mount + open lid + PE retained + valid 7-channel map + daytime shading or verified night"
    },
    {
      "operation": "POWER_BASELINE",
      "requires": "current shade receipt"
    },
    {
      "operation": "PID_STEP",
      "requires": "shade coverage across entire relevant acquisition; gaps flagged"
    },
    {
      "operation": "FIXED_QC",
      "requires": "new version after FIXED_SWAP; old ASSEMBLY_QC cannot satisfy"
    }
  ],
  "loops": [
    {
      "id": "L_OPT",
      "body": [
        "OPT_REFERENCE",
        "OPT_MOUNT",
        "OPT_SCAN",
        "OPT_UNLOAD"
      ],
      "count": "qualified nonempty component by instrument by technical-repeat schedule",
      "station_rule": "Run entire loop at one bound instrument, then MOVE before other instrument"

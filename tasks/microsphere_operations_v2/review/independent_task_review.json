  "corrected_findings": [
    {
      "id": "IT01",
      "finding": "Receipt branch statuses and final dispositions could disagree with payloads or promote held/source-only/unrun branches",
      "resolution": "Exact payload/result reconciliation and prior final-state equality enforced; independent negative tests pass"
    },
    {
      "id": "IT02",
      "finding": "Closeout could substitute specimen identities",
      "resolution": "Received identities bound to inventory; all-held intake uses null/not_received records and rejects invented identities"
    },
    {
      "id": "IT03",
      "finding": "Malformed nested receipt values could escape as unlogged TypeError or KeyError",
      "resolution": "Fail-closed ContractError handling appends rejected history; malformed common and nested values tested"
    },
    {
      "id": "IT04",
      "finding": "SIL measurement states and contact receipts lacked an enforced lineage link",
      "resolution": "Distinct contact child states, specimen IDs and contact receipt IDs enforced while preserving objective and focus differences"
    },
    {
      "id": "IT05",
      "finding": "Comparison metric policy could change after prospective plan freeze",
      "resolution": "R11 policy must match R01 policy; post hoc substitution rejected"
    },
    {
      "id": "IT06",
      "finding": "Exporter private-path scanner would reject its own literal denylist",
      "resolution": "Equivalent split pattern construction preserves package-wide scan without self-matching"
    },
    {
      "id": "IT07",
      "finding": "Root/metadata symlink and ZIP-level comment paths needed preflight guards",
      "resolution": "Root and metadata symlinks rejected before resolve/read; global and member ZIP metadata tests pass"
    },
    {
      "id": "IT08",
      "finding": "Held R06 specimen identity could drift",
      "resolution": "Held specimen linked to the accepted inventory and independently regression-tested"
    },
    {
      "id": "IT09",
      "finding": "Source audit depended on an external sibling review folder",
      "resolution": "Original-only compact reference snapshot shipped; both standalone and optional external-reference tests pass"
    }
  ],
  "evidence_limits": [
    "Finite software tests and review, not a proof over every possible input",
    "Trusted evaluator receipt tokens and fixture hashes do not authenticate external facilities, calibrations or laboratory observations",
    "No laboratory hardware, robotics, physical/optical simulation, biological activity or scientific remeasurement was performed",
    "Source outcomes remain context only; no source media, raw data or rendered views were generated as experimental evidence",
    "All sixteen qualification groups remain unresolved for real physical activity",
    "Scene-native geometry, visual quality and scene export are subject to a separate scene review; this audit checked only shared contract bytes",

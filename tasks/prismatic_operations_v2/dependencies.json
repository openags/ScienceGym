  "branch_stage_dependencies": [
    {
      "id": "D_FAB_QC",
      "rule": "cut/print receipts and piece identities precede PART_QC; required accepted pieces precede joint operations; complete joint manifest precedes SAMPLE_QC"
    },
    {
      "id": "D_TRANSFER",
      "rule": "Every physical station transition requires supported carrier, MOVE and destination-dock observation; data-only operations need no specimen relocation"
    },
    {
      "id": "D_LOAD_UNLOAD",
      "rule": "Each unload record is bound to its own loading leg, same cycle ID, specimen version and condition signature"
    },
    {
      "id": "D_RELEASE_OBSERVE",
      "rule": "Target actuation precedes load-off evidence, which precedes the relaxation observation window; holding contact invalidates unloaded-state classification"
    },
    {
      "id": "D_TARGET_RETRY",
      "rule": "Next attempt on reused sample depends on prior final-state observation, integrity check and qualified reset; a new occurrence ID prevents destructive overwrite"
    },
    {
      "id": "D_ARRAY_UNIT",
      "rule": "Each of eight slots requires a distinct qualified unit parent receipt before array join; all intercell joins checked before actuation"
    },
    {
      "id": "D_PNEU",
      "rule": "Qualified specimen, attachment and port graph precede commands; supply off plus safe residual-pressure readback precede disconnect"
    },
    {
      "id": "D_CLOSURE",
      "rule": "Required report depends on selected datasets or blockers, specimen/component final locations and stopped/reset stations"
    }
  ],
  "loop_expansion": "Loop expansion is symbolic and not executed. Instance IDs include branch, specimen, condition, target/cycle and attempt; only qualified supplied cardinalities expand.",
  "no_fixed_solution": "Order among independent work is unconstrained; evaluator checks partial-order validity and physical/data evidence rather than action-list imitation."
}

{
  "schema_version": "woven_material_task.v1",
  "must_reject": [
    "Actor measurement/safe/success/qualification injection",
    "Unknown fixture and wrong types",
    "Missing/duplicate/reordered/extra event",
    "Cross-episode/sample/route replay",
    "Coherent context or receipt forgery",
    "Changed raw hash/timebase/images",
    "Request used as observation",
    "Prepared route fabrication credit",
    "Tetra release without resolution",
    "Missing support/coating order approval",
    "Undock without safe release",
    "Damage reuse",
    "Nonfinite/boolean/invalid/underflowed numeric data",
    "Unclosed or reversed signed cycle",
    "Source expected outcome in actor projection",
    "Unknown/mutated/symlink/binary/traversal/duplicate export files",
    "ZIP comments, extra fields, prefix/trailing data"
  ],
  "positive_boundary_cases": [
    "Both externally specified plasma/coating orders honor source partial order",
    "BCC/cubic unaffected by tetra hold",
    "Signed compression preserved",
    "Held/failed attempts archived without scientific completion"
  ]
}
